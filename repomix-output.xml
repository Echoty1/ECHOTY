  color: var(--text-muted);
  cursor: pointer;
  flex-shrink: 0;
  padding: 4px 6px;
}
.echo-bookmark-item button:hover {
  color: #ef4444;
}
.echo-bookmark-source {
  color: var(--text-muted);
  font-weight: 500;
  font-size: 12px;
}
