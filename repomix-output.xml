}

/* ─── Base Styles ────────────────────────────────────────────── */
html,
body,
#root {
  height: 100%;
  width: 100%;
  overflow: hidden; /* no page scroll */
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0) !important;
  touch-action: manipulation; /* Prevents zoom on double-tap */
