/* src/components/pages/Chat/ChatView.css */

:root {
  --header-height: 60px;
  --nav-bottom-offset: 88px;
}

.chat-view {
  position: fixed;
  top: var(--header-height);
  bottom: var(--nav-bottom-offset);
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  background: #0A0A0F;
  overflow: hidden;
  margin: 0 !important;
  padding: 0 !important;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  z-index: 10;
}

/* ─── Messages container ────────────────────────────────────── */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 16px 16px 12px !important;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0 !important;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

/* ─── Empty state ───────────────────────────────────────────── */
.empty-chat-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #666;
  gap: 12px;
  padding: 40px 20px;
  margin: 0 auto;
  max-width: 320px;
  width: 100%;
  height: 100%;
}

.empty-icon {
  font-size: 48px;
  color: rgba(108, 60, 225, 0.3);
  margin-bottom: 4px;
}

.empty-chat-state p {
  font-size: 16px;
  font-weight: 500;
  color: #888;
  margin: 0;
  letter-spacing: 0.3px;
}

.empty-chat-state .empty-sub {
  font-size: 13px;
  color: #555;
  margin-top: -4px;
}

/* ─── Chat bubbles ──────────────────────────────────────────── */
.message-bubble {
  max-width: 85%;
  padding: 10px 14px;
  border-radius: 16px;
  font-size: 14px;
  line-height: 1.4;
  word-break: break-word;
  transition: all 0.2s ease;
}

.message-bubble.own {
  align-self: flex-end;
  background: #6C3CE1;
  color: #fff;
  border-bottom-right-radius: 4px;
}

.message-bubble.partner {
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  border-bottom-left-radius: 4px;
}

.message-bubble.deleting {
  animation: deleteShrink 0.3s ease forwards;
}
.message-bubble.highlight-flash {
  animation: highlightPulse 1s ease;
}

@keyframes deleteShrink {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.95); }
  100% { opacity: 0; transform: scale(0.8); max-height: 0; padding: 0; margin: 0; overflow: hidden; }
}
@keyframes highlightPulse {
  0% { background-color: rgba(108, 60, 225, 0.3); }
  50% { background-color: rgba(108, 60, 225, 0.6); }
  100% { background-color: transparent; }
}

/* ─── Media wrappers ──────────────────────────────────────────── */
.chat-media-video-wrapper,
.chat-media-image-wrapper {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: #000;
  cursor: pointer;
  width: 100%;
  max-width: 100%;
}

.chat-media-video {
  width: 100%;
  max-height: 400px;
  display: block;
  background: #000;
}

.chat-media-image {
  width: 100%;
  max-height: 400px;
  object-fit: contain;
  display: block;
  background: #0A0A0F;
  transition: opacity 0.3s ease;
}

.chat-media-caption {
  padding: 8px 10px 6px;
  color: #ddd;
  font-size: 13px;
  line-height: 1.4;
  background: transparent;
  word-break: break-word;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  margin-top: 4px;
}

/* ─── Upload overlay (spinner only) ──────────────────────────── */
.media-upload-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(2px);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  z-index: 3;
}

.upload-spinner {
  position: relative;
  width: 50px;
  height: 50px;
}

.spinner-ring {
  animation: spin 1s linear infinite;
  transform-origin: center;
}

.spinner-path {
  stroke: #6C3CE1;
  stroke-dasharray: 125;
  stroke-dashoffset: 125;
  animation: dash 1.5s ease-in-out infinite;
}

@keyframes spin {
  100% { transform: rotate(360deg); }
}
@keyframes dash {
  0% { stroke-dashoffset: 125; }
  50% { stroke-dashoffset: 0; }
  100% { stroke-dashoffset: -125; }
}

/* ─── Inline video controls ────────────────────────────────── */
.video-mute-btn-overlay {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background: rgba(0, 0, 0, 0.6);
  border: none;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  cursor: pointer;
  font-size: 14px;
  backdrop-filter: blur(4px);
  transition: background 0.2s;
  z-index: 2;
  pointer-events: auto;
}
.video-mute-btn-overlay:hover {
  background: rgba(255, 255, 255, 0.2);
}

/* Partner messages: mute button on the left */
.message-bubble.partner .video-mute-btn-overlay {
  right: auto;
  left: 12px;
}

.video-play-icon-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: rgba(255, 255, 255, 0.85);
  font-size: 56px;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  pointer-events: none;
  transition: transform 0.2s;
}
.chat-media-video-wrapper:hover .video-play-icon-overlay {
  transform: translate(-50%, -50%) scale(1.05);
}

.video-loading-spinner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 28px;
}

/* ─── Lightbox ────────────────────────────────────────────────── */
.media-lightbox-overlay {
  position: fixed;
  top: 0 !important;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999 !important;
  padding: 20px;
  backdrop-filter: blur(8px);
}
.media-lightbox-content {
  position: relative;
  max-width: 90%;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.media-lightbox-image {
  max-width: 100%;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
}
.media-lightbox-caption {
  color: #ddd;
  font-size: 16px;
  margin-top: 12px;
  text-align: center;
  max-width: 80%;
}
.media-lightbox-close {
  position: absolute;
  top: 12px;
  right: 12px;
  background: rgba(0, 0, 0, 0.6);
  border: none;
  color: #fff;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

/* ─── Fullscreen Video Player ────────────────────────────────── */
.fullscreen-video-overlay {
  position: fixed;
  top: 0 !important;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.95);
  z-index: 999999 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
}
.fullscreen-video-content {
  position: relative;
  max-width: 90%;
  max-height: 90vh;
  width: 100%;
  height: auto;
}
.fullscreen-video {
  width: 100%;
  height: auto;
  max-height: 90vh;
  object-fit: contain;
  border-radius: 8px;
}
.fullscreen-close-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  background: rgba(0, 0, 0, 0.6);
  border: none;
  color: #fff;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  font-size: 22px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
  transition: background 0.2s;
}
.fullscreen-close-btn:hover {
  background: rgba(255, 255, 255, 0.2);
}
.fullscreen-play-btn {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.6);
  border: none;
  color: #fff;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  font-size: 28px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
  transition: transform 0.2s, background 0.2s;
}
.fullscreen-play-btn:hover {
  transform: translateX(-50%) scale(1.1);
  background: rgba(255, 255, 255, 0.2);
}
.fullscreen-loading-spinner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: #fff;
  font-size: 18px;
}
.fullscreen-loading-spinner i {
  font-size: 40px;
  opacity: 0.7;
}
.fullscreen-error {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: #fff;
  font-size: 16px;
  text-align: center;
}
.fullscreen-error i {
  font-size: 40px;
  color: #ef4444;
}
.fullscreen-error button {
  background: #6C3CE1;
  border: none;
  color: #fff;
  padding: 8px 20px;
  border-radius: 20px;
  cursor: pointer;
  font-weight: 600;
}

/* ─── Image Error Placeholder ────────────────────────────────── */
.image-error-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 200px;
  background: rgba(255, 255, 255, 0.05);
  color: #888;
  gap: 16px;
  border-radius: 12px;
}
.image-retry-btn {
  background: #6C3CE1;
  border: none;
  color: #fff;
  padding: 8px 20px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: background 0.2s;
}
.image-retry-btn:hover {
  background: #7C4CE1;
}

/* ─── Media Preview Overlay (pre‑send) ────────────────────────── */
.media-preview-overlay {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 18, 26, 0.97);
  backdrop-filter: blur(20px);
  padding: 20px 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-height: 70vh;
  overflow-y: auto;
  z-index: 99998;
  animation: slideUp 0.3s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.media-preview-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 600px;
  margin: 0 auto;
  width: 100%;
}
.media-preview-close {
  align-self: flex-end;
  background: rgba(255, 255, 255, 0.08);
  border: none;
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  padding: 6px 12px;
  border-radius: 30px;
  transition: background 0.2s;
}
.media-preview-close:hover {
  background: rgba(255, 255, 255, 0.15);
}
.media-preview-media {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #000;
  border-radius: 12px;
  overflow: hidden;
  max-height: 350px;
  min-height: 120px;
}
.media-preview-image,
.media-preview-video {
  max-width: 100%;
  max-height: 350px;
  object-fit: contain;
}
.media-preview-caption {
  width: 100%;
  padding: 12px 16px;
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  color: #fff;
  font-size: 14px;
  outline: none;
  box-sizing: border-box;
}
.media-preview-caption:focus {
  border-color: #6C3CE1;
}
.media-preview-send {
  padding: 12px 24px;
  border-radius: 30px;
  border: none;
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  color: #fff;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.1s;
}
.media-preview-send:hover:not(:disabled) {
  opacity: 0.9;
  transform: scale(1.02);
}
.media-preview-send:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ─── Input bar ──────────────────────────────────────────────── */
.chat-input-container {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  padding: 10px 16px;
  background: rgba(18, 18, 26, 0.95);
  backdrop-filter: blur(16px);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  width: 100%;
}
.chat-input-row {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
}
.chat-attach-btn {
  background: none;
  border: none;
  color: #888;
  font-size: 22px;
  cursor: pointer;
  padding: 4px 8px;
  transition: color 0.2s;
  flex-shrink: 0;
}
.chat-attach-btn:hover {
  color: #a78bfa;
}
.chat-voice-btn {
  background: none;
  border: none;
  color: #888;
  font-size: 22px;
  cursor: pointer;
  padding: 4px 8px;
  transition: color 0.2s;
  flex-shrink: 0;
}
.chat-voice-btn:hover {
  color: #a78bfa;
}
.chat-input {
  flex: 1;
  padding: 12px 18px;
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  color: #fff;
  font-size: 14px;
  outline: none;
}
.chat-input:focus {
  border-color: #6C3CE1;
}
.chat-send-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: none;
  background: #6C3CE1;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.chat-send-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* ─── Message actions (delete & reply) ────────────────────────── */
.message-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
}
.message-actions {
  display: flex;
  gap: 6px;
  position: absolute;
  bottom: 4px;
  right: 4px;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 5;
  pointer-events: none;
}
.message-actions.visible {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}
.message-action-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 13px;
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  transition: background 0.2s, transform 0.15s;
}
.message-action-btn.reply {
  color: #a78bfa;
}
.message-action-btn.reply:hover {
  background: rgba(167, 139, 250, 0.2);
}
.message-action-btn.delete {
  color: #ef4444;
}
.message-action-btn.delete:hover {
  background: rgba(239, 68, 68, 0.2);
}
.message-action-btn:active {
  transform: scale(0.9);
}

/* ─── Reply preview in input bar ──────────────────────────────── */
.reply-preview {
  padding: 10px 16px 6px;
  background: rgba(255, 255, 255, 0.04);
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px 12px 0 0;
  margin: 0 12px;
  width: calc(100% - 24px);
}
.reply-preview-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.reply-preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: #a78bfa;
  font-weight: 600;
}
.reply-preview-header strong {
  color: #fff;
  font-weight: 700;
}
.reply-preview-close {
  background: none;
  border: none;
  color: #888;
  cursor: pointer;
  font-size: 16px;
  padding: 4px 8px;
  border-radius: 50%;
  transition: background 0.2s;
}
.reply-preview-close:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}
.reply-preview-body {
  font-size: 14px;
  color: #ccc;
  padding-left: 4px;
  border-left: 3px solid #6C3CE1;
  padding-left: 12px;
  display: flex;
  align-items: center;
  min-height: 28px;
}
.reply-preview-text {
  opacity: 0.9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 90%;
  display: block;
  font-weight: 500;
}

/* ─── Replied message inside bubble ────────────────────────────── */
.replied-message {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 8px 10px;
  margin-bottom: 6px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  border-left: 4px solid #6C3CE1;
  cursor: pointer;
  transition: background 0.15s;
}
.replied-message:hover {
  background: rgba(255, 255, 255, 0.1);
}
.replied-message-line {
  display: none;
}
.replied-message-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}
.replied-message-sender {
  font-size: 12px;
  font-weight: 700;
  color: #a78bfa;
  letter-spacing: 0.3px;
}
.replied-message-text {
  font-size: 14px;
  color: #ccc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 500;
}
.message-bubble.own .replied-message {
  background: rgba(255, 255, 255, 0.08);
  border-left-color: #a78bfa;
}
.message-bubble.own .replied-message-sender {
  color: #c4b5fd;
}
.message-bubble.own .replied-message-text {
  color: #e5e7eb;
}
.message-bubble.partner .replied-message {
  background: rgba(255, 255, 255, 0.05);
}
.message-bubble.partner .replied-message-sender {
  color: #a78bfa;
}
.message-bubble.partner .replied-message-text {
  color: #d1d5db;
}

/* ─── Delete Confirmation Modal ────────────────────────────────── */
.delete-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999;
  animation: fadeIn 0.2s ease;
}
.delete-modal-content {
  background: #1a1a24;
  border-radius: 20px;
  padding: 32px 28px 24px;
  max-width: 380px;
  width: 90%;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
  animation: modalScale 0.2s ease;
}
.delete-modal-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  font-size: 24px;
  color: #ef4444;
}
.delete-modal-content h3 {
  color: #fff;
  font-size: 18px;
  margin: 0 0 8px;
}
.delete-modal-content p {
  color: #aaa;
  font-size: 14px;
  line-height: 1.5;
  margin: 0 0 20px;
}
.delete-modal-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
}
.delete-modal-btn {
  padding: 10px 24px;
  border-radius: 30px;
  border: none;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
  min-width: 100px;
}
.delete-modal-btn.cancel {
  background: rgba(255, 255, 255, 0.08);
  color: #ccc;
}
.delete-modal-btn.cancel:hover {
  background: rgba(255, 255, 255, 0.15);
}
.delete-modal-btn.confirm {
  background: #ef4444;
  color: #fff;
}
.delete-modal-btn.confirm:hover {
  background: #dc2626;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes modalScale {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* ─── GIF message ────────────────────────────────────────────── */
.gif-message-container {
  max-width: 100%;
  border-radius: 12px;
  overflow: hidden;
  background: transparent;
}
.gif-message-img {
  width: 100%;
  max-height: 300px;
  object-fit: contain;
  display: block;
  border-radius: 12px;
}
.gif-message-caption {
  padding: 6px 8px 4px;
  color: #ddd;
  font-size: 13px;
  text-align: center;
  opacity: 0.8;
}

/* ─── Typing indicator ────────────────────────────────────────── */
.typing-indicator {
  display: flex;
  gap: 6px;
  padding: 4px 0;
}
.typing-indicator span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #888;
  animation: typingBounce 1.2s infinite ease-in-out;
}
.typing-indicator span:nth-child(2) {
  animation-delay: 0.2s;
}
.typing-indicator span:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-10px); }
}

/* ─── Voice Recorder (mobile‑optimized bottom sheet) ───────── */
.voice-recorder-overlay {
  position: fixed;
  bottom: 88px;
  left: 50%;
  transform: translateX(-50%);
  width: 92%;
  max-width: 420px;
  background: rgba(18, 18, 26, 0.97);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  padding: 10px 16px;
  z-index: 99999;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
  animation: voiceSlideUp 0.25s ease-out;
}

@keyframes voiceSlideUp {
  from {
    transform: translateX(-50%) translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
}

.voice-recorder-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.voice-recorder-status {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}
.recording-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ef4444;
  animation: pulse-dot 1s infinite;
}
.recording-time {
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.voice-recorder-preview {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}
.audio-waveform {
  display: flex;
  align-items: center;
  gap: 2px;
  height: 30px;
  flex: 1;
}
.audio-waveform .waveform-bar {
  width: 3px;
  border-radius: 2px;
  background: #a78bfa;
  animation: none;
  height: 10px;
}
.audio-duration {
  font-size: 14px;
  color: #aaa;
  font-variant-numeric: tabular-nums;
}

.voice-recorder-actions {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-shrink: 0;
}
.recorder-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  cursor: pointer;
  transition: transform 0.15s, background 0.2s;
}
.recorder-btn:hover {
  transform: scale(1.05);
}
.recorder-btn.start {
  background: #6C3CE1;
  color: #fff;
}
.recorder-btn.stop {
  background: #ef4444;
  color: #fff;
}
.recorder-btn.send {
  background: #10B981;
  color: #fff;
}
.recorder-btn.cancel {
  background: rgba(255, 255, 255, 0.08);
  color: #888;
}
.recorder-btn.cancel:hover {
  background: rgba(255, 255, 255, 0.15);
}

/* ─── Responsive for smaller screens ────────────────────────── */
@media (max-width: 480px) {
  .voice-recorder-overlay {
    bottom: 76px;
    width: 94%;
    padding: 8px 12px;
  }
  .recorder-btn {
    width: 32px;
    height: 32px;
    font-size: 14px;
  }
  .recording-time {
    font-size: 14px;
  }
  .audio-duration {
    font-size: 12px;
  }
  .audio-waveform .waveform-bar {
    width: 2px;
  }
}

/* ─── Audio Player inside message bubble ────────────────────── */
.message-bubble .audio-player {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 8px 12px;
  border-radius: 30px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
}

.message-bubble.own .audio-player {
  background: rgba(108, 60, 225, 0.2);
  border: 1px solid rgba(108, 60, 225, 0.3);
}

.audio-play-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s, transform 0.15s;
}
.audio-play-btn:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
}
.message-bubble.own .audio-play-btn {
  background: rgba(108, 60, 225, 0.5);
}
.message-bubble.own .audio-play-btn:hover {
  background: rgba(108, 60, 225, 0.7);
}

.audio-progress {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

/* ─── Waveform bars ────────────────────────────────────────────── */
.audio-waveform-bars {
  display: flex;
  align-items: center;
  gap: 2px;
  height: 28px;
}
.audio-waveform-bars .waveform-bar {
  width: 3px;
  border-radius: 2px;
  background: #a78bfa;
  transition: height 0.15s ease;
  will-change: height;
}
.message-bubble.own .audio-waveform-bars .waveform-bar {
  background: #c4b5fd;
}

/* ─── Slider ───────────────────────────────────────────────────── */
.audio-slider {
  width: 100% !important;
  height: 3px;
  -webkit-appearance: none;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2px;
  outline: none;
  transition: background 0.2s;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
}
.message-bubble.own .audio-slider {
  background: rgba(108, 60, 225, 0.3);
}
.audio-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #6C3CE1;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(108, 60, 225, 0.3);
}
.audio-slider::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #6C3CE1;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(108, 60, 225, 0.3);
}

.audio-time {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  color: #888;
  letter-spacing: 0.3px;
}
.message-bubble.own .audio-time {
  color: #c4b5fd;
}

/* ─── Responsive ──────────────────────────────────────────────── */
@media (max-width: 480px) {
  .message-bubble {
    max-width: 90%;
    font-size: 13px;
    padding: 8px 12px;
  }
  .chat-input-container {
    padding: 8px 12px;
  }
  .chat-input {
    padding: 10px 14px;
    font-size: 13px;
  }
  .chat-send-btn {
    width: 36px;
    height: 36px;
  }
  .chat-attach-btn,
  .chat-voice-btn {
    font-size: 18px;
    padding: 2px 6px;
  }
  .media-preview-overlay {
    padding: 16px 12px;
    max-height: 80vh;
  }
  .media-preview-media {
    max-height: 250px;
    min-height: 80px;
  }
  .media-preview-image,
  .media-preview-video {
    max-height: 250px;
  }
  .empty-icon {
    font-size: 36px;
  }
  .empty-chat-state p {
    font-size: 14px;
  }
  .delete-modal-content {
    padding: 24px 20px;
  }
  .delete-modal-btn {
    min-width: 80px;
    padding: 8px 16px;
    font-size: 13px;
  }
  .message-actions {
    bottom: 2px;
    right: 2px;
    gap: 4px;
  }
  .message-action-btn {
    width: 28px;
    height: 28px;
    font-size: 11px;
  }
  .reply-preview {
    padding: 6px 12px;
    margin: 0 8px;
  }
  .voice-recorder-overlay {
    min-width: 260px;
    padding: 16px 20px;
    bottom: 80px;
  }
  .message-bubble .audio-player {
    padding: 6px 10px;
  }
}

/* ─── Invalid media placeholder ────────────────────────────── */
.media-error-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 20px;
  min-height: 120px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  color: #888;
}
.media-error-placeholder i {
  font-size: 28px;
  opacity: 0.4;
}
.media-error-placeholder button {
  background: #6C3CE1;
  border: none;
  color: #fff;
  padding: 4px 16px;
  border-radius: 16px;
  cursor: pointer;
  font-weight: 600;
}

.audio-placeholder {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  color: #888;
  font-size: 13px;
}
.audio-placeholder i {
  font-size: 18px;
  opacity: 0.5;
}

.audio-error-placeholder {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 8px;
  color: #ef4444;
  font-size: 13px;
}
.audio-error-placeholder button {
  background: #6C3CE1;
  border: none;
  color: #fff;
  padding: 2px 12px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
}
