  border-radius: 4px;
}

/* ─── Notification items ────────────────────────────────────── */
.notification-dropdown .notification-item {
  padding: 10px 16px;
  border-bottom: 1px solid var(--border-color);
  cursor: pointer;
  transition: background 0.15s;
}
.notification-dropdown .notification-item:hover {
