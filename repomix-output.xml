  const [selectAll, setSelectAll] = useState(false);

  // ─── Admin Message ───────────────────────────────────────────
  const [adminMessageTitle, setAdminMessageTitle] = useState('');
  const [adminMessageBody, setAdminMessageBody] = useState('');

  // ─── Confirm Modal ──────────────────────────────────────────
  const [confirmModal, setConfirmModal] = useState({
    isOpen: false,
    title: '',
    message: '',
    confirmText: 'Confirm',
    cancelText: 'Cancel',
    showInput: false,
    inputPlaceholder: '',
