}
.community-member-count {
  display: flex;
  align-items: center;
  gap: 4px;
}
.community-member-count i {
  color: #8B5CF6;
  font-size: 13px;
}
.community-card-category {
  text-transform: capitalize;
  opacity: 0.7;
  font-size: 10px;
  background: rgba(255, 255, 255, 0.06);
  padding: 2px 12px;
