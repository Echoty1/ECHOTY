  }
}
/* ─── Chat background toggle ───────────────────────────────── */
.echo-toggle-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 8px;
  padding: 8px 4px;
  background: none;
  border: none;
