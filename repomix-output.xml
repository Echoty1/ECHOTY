  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
}
.echo-toggle-track {
  width: 48px;
  height: 28px;
  border-radius: 20px;
  background: var(--border-color);
  position: relative;
  transition: background 0.2s;
