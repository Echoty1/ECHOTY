}

@keyframes live-badge-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.online-dot {
  position: absolute;
  bottom: 2px;
  right: 2px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #4ade80;
  border: 2px solid var(--bg-primary);
  box-shadow: 0 0 16px rgba(74, 222, 128, 0.5);
}

.live-username {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 80px;
  text-align: center;
}

.live-empty {
  color: var(--text-muted);
  font-size: 15px;
  text-align: center;
  padding: 20px 0;
  width: 100%;
}

/* ─── Go Live Button ──────────────────────────────────────────── */
.go-live-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  padding: 16px 20px;
  margin-top: 12px;
  border: none;
  border-radius: 16px;
  font-weight: 700;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.25s ease;
  color: #fff;
  background: linear-gradient(135deg, #8b5cf6, #6d28d9);
  box-shadow: 0 8px 30px rgba(139, 92, 246, 0.3);
}

.go-live-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(139, 92, 246, 0.4);
}

.go-live-btn:active {
  transform: scale(0.98);
}

.go-live-btn.is-live {
  background: linear-gradient(135deg, #f87171, #dc2626);
  box-shadow: 0 8px 30px rgba(220, 38, 38, 0.3);
}

.go-live-btn.is-live:hover {
  box-shadow: 0 12px 40px rgba(220, 38, 38, 0.4);
}

.go-live-btn i {
  font-size: 20px;
}

/* ─── Peer Error Toast ────────────────────────────────────────── */
.peer-error-toast {
  position: fixed;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  max-width: min(420px, calc(100vw - 32px));
  padding: 12px 16px;
  border-radius: 14px;
  background: rgba(239, 68, 68, 0.95);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 8px 30px rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  gap: 12px;
  backdrop-filter: blur(4px);
}

.peer-error-toast span {
  flex: 1;
}

.peer-error-toast button {
  background: #fff;
  color: #EF4444;
  border: none;
  border-radius: 20px;
  padding: 6px 12px;
  font-weight: 700;
  cursor: pointer;
  font-size: 13px;
  white-space: nowrap;
}

.peer-error-dismiss {
  background: transparent !important;
  color: #fff !important;
  font-size: 18px !important;
  padding: 0 4px !important;
}

/* ─── Responsive ────────────────────────────────────────────────── */
@media (max-width: 600px) {
  .home-page {
    padding: 12px 12px 100px;
  }

  .home-section {
    padding: 20px 16px 18px;
    border-radius: 20px;
  }

  .live-header-left h2 {
    font-size: 18px;
  }

  .live-count-badge {
    font-size: 11px;
    padding: 4px 12px;
  }

  .live-user-card {
    min-width: 72px;
  }

  .live-avatar-ring > * {
    width: 64px;
    height: 64px;
  }

  .live-username {
    font-size: 13px;
    max-width: 70px;
  }

  .go-live-btn {
    font-size: 15px;
    padding: 14px 16px;
  }
}

@media (max-width: 400px) {
  .home-section {
    padding: 16px 12px 14px;
  }

  .live-avatar-ring > * {
    width: 56px;
    height: 56px;
  }

  .live-username {
    font-size: 12px;
    max-width: 60px;
  }

  .live-count-badge {
    font-size: 10px;
    padding: 3px 10px;
  }

  .go-live-btn {
    font-size: 14px;
    padding: 12px 14px;
  }

  .go-live-btn i {
    font-size: 18px;
  }
}
