  min-width: 42px;
  border-radius: 50%;
  border: none;
  background: #6C3CE1;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 18px;
}
.chat-send-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

@media (max-width: 480px) {
  .chat-attach-btn,
  .chat-emoji-btn,
  .chat-voice-btn {
    font-size: 18px !important;
    padding: 2px 6px !important;
  }
  .chat-input-row {
    gap: 6px !important;
  }
  .chat-send-btn {
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    font-size: 14px !important;
  }
  .chat-input {
    font-size: 13px !important;
    padding: 10px 12px !important;
  }
  .message-bubble {
    max-width: 90%;
    font-size: 11px;
    padding: 8px 12px;
  }
  .chat-input-container {
    padding: 8px 12px;
  }
  .chat-send-btn {
    width: 36px;
    height: 36px;
  }
  .chat-attach-btn,
  .chat-emoji-btn,
  .chat-voice-btn {
    font-size: 18px;
    padding: 2px 6px;
  }
  .media-preview-overlay {
    padding: 16px 12px;
    max-height: 80vh;
  }
  .media-preview-media {
    max-height: 250px;
    min-height: 80px;
  }
  .media-preview-image,
  .media-preview-video {
    max-height: 250px;
  }
  .empty-icon {
    font-size: 36px;
  }
  .empty-chat-state p {
    font-size: 14px;
  }
  .delete-modal-content {
    padding: 24px 20px;
  }
  .delete-modal-btn {
    min-width: 80px;
    padding: 8px 16px;
    font-size: 11px;
  }
  .message-actions {
    bottom: 2px;
    right: 2px;
    gap: 4px;
  }
  .message-action-btn {
    width: 28px;
    height: 28px;
    font-size: 11px;
  }
  .reply-preview {
    padding: 6px 12px;
    margin: 0 8px;
  }
  .voice-recorder-overlay {
    min-width: 260px;
    padding: 16px 20px;
    bottom: 80px;
  }
  .message-bubble .audio-player {
    padding: 6px 10px;
  }
}

.message-row,
.message-bubble,
.message-wrapper {
  overflow: visible;
}
.message-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
}
.message-actions {
  display: flex;
  gap: 8px;
  position: absolute;
  top: -32px;
  right: 0;
  z-index: 30;
  opacity: 0;
  transform: none;
  transition: opacity 0.15s ease;
  pointer-events: none;
}
.message-wrapper.partner .message-actions,
.message-bubble.partner .message-actions {
  right: auto;
  left: 0;
}
.message-actions.visible {
  opacity: 1;
  pointer-events: auto;
}
.message-action-btn {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 11px;
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  transition: background 0.2s, transform 0.15s;
}
.message-action-btn.reply {
  color: #a78bfa;
}
.message-action-btn.reply:hover {
  background: rgba(167, 139, 250, 0.2);
}
.message-action-btn.delete {
  color: #ef4444;
}
.message-action-btn.delete:hover {
  background: rgba(239, 68, 68, 0.2);
}
.message-action-btn.copy {
  color: #60A5FA;
}
.message-action-btn.copy:hover {
  background: rgba(96, 165, 250, 0.2);
}
.message-action-btn.copy .fa-check {
  color: #10B981;
}
.message-action-btn:active {
  transform: scale(0.9);
}
.message-action-btn.edit {
  color: #60A5FA;
}
.message-action-btn.edit:hover {
  background: rgba(96, 165, 250, 0.2);
}

.reply-preview {
  padding: 10px 16px 6px;
  background: var(--bg-input);
  border-top: 1px solid var(--border-color);
  border-radius: 12px 12px 0 0;
  margin: 0 12px;
  width: calc(100% - 24px);
}
.reply-preview-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.reply-preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11px;
  color: #a78bfa;
  font-weight: 600;
}
.reply-preview-header strong {
  color: var(--text-primary);
  font-weight: 700;
}
.reply-preview-close {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 16px;
  padding: 4px 8px;
  border-radius: 50%;
  transition: background 0.2s;
}
.reply-preview-close:hover {
  background: var(--bg-input);
  color: var(--text-primary);
}
.reply-preview-body {
  font-size: 14px;
  color: var(--text-secondary);
  padding-left: 4px;
  border-left: 3px solid #6C3CE1;
  padding-left: 12px;
  display: flex;
  align-items: center;
  min-height: 28px;
}
.reply-preview-text {
  opacity: 0.9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 90%;
  display: block;
  font-weight: 500;
}

.replied-message {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 8px 10px;
  margin-bottom: 6px;
  background: var(--bg-input);
  border-radius: 10px;
  border-left: 4px solid #6C3CE1;
  cursor: pointer;
  transition: background 0.15s;
}
.replied-message:hover {
  background: var(--border-color);
}
.replied-message-line {
  display: none;
}
.replied-message-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}
.replied-message-sender {
  font-size: 12px;
  font-weight: 700;
  color: #a78bfa;
  letter-spacing: 0.3px;
}
.replied-message-text {
  font-size: 14px;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 500;
}
.message-bubble.own .replied-message {
  background: rgba(255, 255, 255, 0.08);
  border-left-color: #a78bfa;
}
.message-bubble.own .replied-message-sender {
  color: #c4b5fd;
}
.message-bubble.own .replied-message-text {
  color: #e5e7eb;
}
.message-bubble.partner .replied-message {
  background: var(--bg-input);
}
.message-bubble.partner .replied-message-sender {
  color: #a78bfa;
}
.message-bubble.partner .replied-message-text {
  color: var(--text-secondary);
}

.delete-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999;
  animation: fadeIn 0.2s ease;
}
.delete-modal-content {
  background: var(--bg-secondary);
  border-radius: 20px;
  padding: 32px 28px 24px;
  max-width: 380px;
  width: 90%;
  text-align: center;
  border: 1px solid var(--border-color);
  box-shadow: 0 20px 60px var(--shadow-color);
  animation: modalScale 0.2s ease;
}
.delete-modal-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  font-size: 24px;
  color: #ef4444;
}
.delete-modal-content h3 {
  color: var(--text-primary);
  font-size: 18px;
  margin: 0 0 8px;
}
.delete-modal-content p {
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.5;
  margin: 0 0 20px;
}
.delete-modal-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
}
.delete-modal-btn {
  padding: 10px 24px;
  border-radius: 30px;
  border: none;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
  min-width: 100px;
}
.delete-modal-btn.cancel {
  background: var(--bg-input);
  color: var(--text-secondary);
}
.delete-modal-btn.cancel:hover {
  background: var(--border-color);
}
.delete-modal-btn.confirm {
  background: #ef4444;
  color: #fff;
}
.delete-modal-btn.confirm:hover {
  background: #dc2626;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes modalScale {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.gif-message-container {
  max-width: 100%;
  border-radius: 12px;
  overflow: hidden;
  background: transparent;
}
.gif-message-img {
  width: 100%;
  max-height: 300px;
  object-fit: contain;
  display: block;
  border-radius: 12px;
}
.gif-message-caption {
  padding: 6px 8px 4px;
  color: var(--text-secondary);
  font-size: 11px;
  text-align: center;
  opacity: 0.8;
}

.typing-indicator {
  display: flex;
  gap: 6px;
  padding: 4px 0;
}
.typing-indicator span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--text-muted);
  animation: typingBounce 1.2s infinite ease-in-out;
}
.typing-indicator span:nth-child(2) {
  animation-delay: 0.2s;
}
.typing-indicator span:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-10px); }
}

.voice-recorder-overlay {
  position: fixed;
  bottom: 88px;
  left: 50%;
  transform: translateX(-50%);
  width: 92%;
  max-width: 420px;
  background: var(--bg-secondary);
  backdrop-filter: blur(20px);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 10px 16px;
  z-index: 99999;
  box-shadow: 0 8px 30px var(--shadow-color);
  animation: voiceSlideUp 0.25s ease-out;
}
@keyframes voiceSlideUp {
  from { transform: translateX(-50%) translateY(20px); opacity: 0; }
  to { transform: translateX(-50%) translateY(0); opacity: 1; }
}
.voice-recorder-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.voice-recorder-status {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}
.recording-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ef4444;
  animation: pulse-dot 1s infinite;
}
.recording-time {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}
.voice-recorder-preview {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}
.audio-waveform {
  display: flex;
  align-items: center;
  gap: 2px;
  height: 30px;
  flex: 1;
}
.audio-waveform .waveform-bar {
  width: 3px;
  border-radius: 2px;
  background: #a78bfa;
  animation: none;
  height: 10px;
}
.audio-duration {
  font-size: 14px;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}
.voice-recorder-actions {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-shrink: 0;
}
.recorder-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  cursor: pointer;
  transition: transform 0.15s, background 0.2s;
}
.recorder-btn:hover {
  transform: scale(1.05);
}
.recorder-btn.start {
  background: #6C3CE1;
  color: #fff;
}
.recorder-btn.stop {
  background: #ef4444;
  color: #fff;
}
.recorder-btn.send {
  background: #10B981;
  color: #fff;
}
.recorder-btn.cancel {
  background: var(--bg-input);
  color: var(--text-muted);
}
.recorder-btn.cancel:hover {
  background: var(--border-color);
}

.message-bubble .audio-player {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 8px 12px;
  border-radius: 30px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-sizing: border-box;
  background: var(--bg-input);
}
.message-bubble.own .audio-player {
  background: rgba(108, 60, 225, 0.2);
  border: 1px solid rgba(108, 60, 225, 0.3);
}
.audio-play-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s, transform 0.15s;
}
.audio-play-btn:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
}
.message-bubble.own .audio-play-btn {
  background: rgba(108, 60, 225, 0.5);
}
.message-bubble.own .audio-play-btn:hover {
  background: rgba(108, 60, 225, 0.7);
}
.audio-progress {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.audio-waveform-bars {
  display: flex;
  align-items: center;
  gap: 2px;
  height: 28px;
}
.audio-waveform-bars .waveform-bar {
  width: 3px;
  border-radius: 2px;
  background: #a78bfa;
  transition: height 0.15s ease;
  will-change: height;
}
.message-bubble.own .audio-waveform-bars .waveform-bar {
  background: #c4b5fd;
}
.audio-slider {
  width: 100% !important;
  height: 3px;
  -webkit-appearance: none;
  background: var(--border-color);
  border-radius: 2px;
  outline: none;
  transition: background 0.2s;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
}
.message-bubble.own .audio-slider {
  background: rgba(108, 60, 225, 0.3);
}
.audio-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #6C3CE1;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(108, 60, 225, 0.3);
}
.audio-slider::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #6C3CE1;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(108, 60, 225, 0.3);
}
.audio-time {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  color: var(--text-muted);
  letter-spacing: 0.3px;
}
.message-bubble.own .audio-time {
  color: #c4b5fd;
}

.media-error-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 20px;
  min-height: 120px;
  background: var(--bg-input);
  border-radius: 12px;
  color: var(--text-muted);
}
.media-error-placeholder i {
  font-size: 28px;
  opacity: 0.4;
}
.media-error-placeholder button {
  background: #6C3CE1;
  border: none;
  color: #fff;
  padding: 4px 16px;
  border-radius: 16px;
  cursor: pointer;
  font-weight: 600;
}

.audio-placeholder {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  color: var(--text-muted);
  font-size: 11px;
}
.audio-placeholder i {
  font-size: 18px;
  opacity: 0.5;
}

.audio-error-placeholder {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 8px;
  color: #ef4444;
  font-size: 11px;
}
.audio-error-placeholder button {
  background: #6C3CE1;
  border: none;
  color: #fff;
  padding: 2px 12px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
}

.audio-loading-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 16px;
  min-height: 50px;
  background: var(--bg-input);
  border-radius: 30px;
}
.audio-loading-placeholder .upload-spinner {
  width: 28px;
  height: 28px;
}

.message-edited-badge {
  font-size: 10px;
  color: var(--text-muted);
  margin-left: 6px;
  font-weight: 400;
  letter-spacing: 0.3px;
}

/* Emoji picker inline */
.emoji-picker-inline {
  background: var(--bg-secondary);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  max-height: 260px;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  overflow: hidden;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.emoji-picker-tabs {
  display: flex;
  border-bottom: 1px solid var(--border-color);
  flex-shrink: 0;
}
.emoji-picker-tab {
  flex: 1;
  padding: 10px;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  border-bottom: 2px solid transparent;
}
.emoji-picker-tab.active {
  color: var(--text-primary);
  border-bottom-color: #6C3CE1;
}
.emoji-picker-tab:hover {
  background: var(--bg-input);
}

.emoji-picker-content {
  flex: 1;
  overflow-y: auto;
  padding: 10px 8px;
  scroll-behavior: smooth;
  max-height: 200px;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.emoji-picker-content::-webkit-scrollbar {
  display: none;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
}
.emoji-item {
  background: transparent;
  border: none;
  font-size: 26px;
  padding: 4px;
  cursor: pointer;
  border-radius: 8px;
  transition: background 0.15s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.emoji-item:hover {
  background: var(--bg-input);
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
  padding: 4px 2px;
}
.mood-item {
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 8px 2px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  transition: all 0.2s;
}
.mood-item:hover {
  background: rgba(108, 60, 225, 0.12);
  border-color: rgba(108, 60, 225, 0.2);
}
.mood-label {
  font-size: 9px;
  color: var(--text-muted);
  text-transform: capitalize;
  font-weight: 500;
}
.mood-footer {
  text-align: center;
  padding: 6px 0 4px;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.3px;
  border-top: 1px solid var(--border-color);
  margin-top: 6px;
}

@media (max-width: 480px) {
  .emoji-picker-inline {
    max-height: 220px;
  }
  .emoji-picker-content {
    max-height: 160px;
    padding: 6px 4px;
  }
  .emoji-grid {
    grid-template-columns: repeat(6, 1fr);
  }
  .mood-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .emoji-item {
    font-size: 22px;
    padding: 2px;
  }
}

/* Echo Input */
.echo-input-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  min-height: 44px;
}
.echo-input {
  flex: 1;
  padding: 10px 16px;
  border-radius: 24px;
  border: 1px solid var(--border-color);
  background: var(--bg-input);
  color: var(--text-primary);
  font-size: 14px;
  outline: none;
  min-height: 44px;
  max-height: 120px;
  overflow-y: auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 2px;
  cursor: text;
  line-height: 1.4;
  transition: border-color 0.2s;
  scrollbar-width: none !important;
  -ms-overflow-style: none !important;
}
.echo-input::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  background: transparent !important;
}
.echo-input:focus {
  border-color: #6C3CE1;
}
.echo-input .echomoji-inline {
  display: inline-block;
  vertical-align: middle;
  margin: 0 2px;
  line-height: 0;
}
.echo-input .echomoji-inline .echomoji {
  width: 28px !important;
  height: 28px !important;
}
.echo-input .echomoji-inline .echomoji .echomoji-rings {
  display: none !important;
}
.echo-input-placeholder {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  pointer-events: none;
  font-size: 14px;
  transition: opacity 0.2s;
}
.echo-input:not(:empty) ~ .echo-input-placeholder,
.echo-input:focus ~ .echo-input-placeholder {
  opacity: 0;
}

.edit-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999;
  animation: fadeIn 0.2s ease;
}
.edit-modal-content {
  background: var(--bg-secondary);
  border-radius: 20px;
  padding: 24px 28px 20px;
  max-width: 420px;
  width: 90%;
  border: 1px solid var(--border-color);
  box-shadow: 0 20px 60px var(--shadow-color);
  animation: modalScale 0.2s ease;
}
.edit-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.edit-modal-header h3 {
  color: var(--text-primary);
  font-size: 18px;
  margin: 0;
}
.edit-modal-close {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 20px;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 50%;
  transition: background 0.2s;
}
.edit-modal-close:hover {
  background: var(--bg-input);
  color: var(--text-primary);
}
.edit-modal-textarea {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--border-color);
  background: var(--bg-input);
  color: var(--text-primary);
  font-size: 15px;
  font-family: inherit;
  resize: vertical;
  outline: none;
  box-sizing: border-box;
  min-height: 80px;
}
.edit-modal-textarea:focus {
  border-color: #6C3CE1;
}
.edit-modal-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  margin-top: 16px;
}
.edit-modal-btn {
  padding: 10px 24px;
  border-radius: 30px;
  border: none;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}
.edit-modal-btn.cancel {
  background: var(--bg-input);
  color: var(--text-secondary);
}
.edit-modal-btn.cancel:hover {
  background: var(--border-color);
}
.edit-modal-btn.save {
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  color: #fff;
}
.edit-modal-btn.save:hover:not(:disabled) {
