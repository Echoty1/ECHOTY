<file path="src/utils/echoTides.js">
export const PRIVATE_TTL_MS = 24 * 60 * 60 * 1000;
export const COMMUNITY_TTL_MS = 7 * 24 * 60 * 60 * 1000;

export const privateExpiresAt = (from = Date.now()) => from + PRIVATE_TTL_MS;
export const communityExpiresAt = (from = Date.now()) => from + COMMUNITY_TTL_MS;

export const isTideExpired = (msg) => {
  if (!msg || msg.pinned || msg.savedLocal) return false;
  const exp = Number(msg.expiresAt || 0);
  return exp > 0 && exp <= Date.now();
};

export const tideProgress = (msg, ttl = PRIVATE_TTL_MS) => {
  const exp = Number(msg?.expiresAt || 0);
  if (!exp) return 1;
  const left = exp - Date.now();
  if (left <= 0) return 0;
  return Math.max(0, Math.min(1, left / ttl));
};

export const formatTideLeft = (msg) => {
  const exp = Number(msg?.expiresAt || 0);
  if (!exp) return '';
  const left = exp - Date.now();
  if (left <= 0) return '0m';
  const h = Math.floor(left / 3600000);
  const d = Math.floor(h / 24);
  if (d >= 1) return `${d}d`;
  if (h >= 1) return `${h}h`;
  return `${Math.max(1, Math.floor(left / 60000))}m`;
};
</file>

<file path="src/utils/sortMessages.js">
// src/utils/sortMessages.js
// Oldest first so new messages always land at the bottom.
export function msgTime(m) {
  if (!m) return 0;
  const raw = m.timestamp ?? m.createdAt ?? m.sentAt ?? m.clientTs ?? m.time;
  if (typeof raw === 'number' && Number.isFinite(raw)) {
    return raw < 1e12 ? raw * 1000 : raw;
  }
  if (typeof raw === 'string' && raw.trim()) {
    const n = Number(raw);
    if (Number.isFinite(n)) return n < 1e12 ? n * 1000 : n;
    const parsed = Date.parse(raw);
    if (Number.isFinite(parsed)) return parsed;
  }
  if (raw && typeof raw === 'object') {
    if (typeof raw.toMillis === 'function') return raw.toMillis();
    if (typeof raw.toDate === 'function') return raw.toDate().getTime();
    if (typeof raw.seconds === 'number') return raw.seconds * 1000 + Math.floor((raw.nanoseconds || 0) / 1e6);
  }
  const id = String(m.id || m.key || '');
  if (id.charAt(0) === '-') return 0;
  return 0;
}

export function sortMessages(list) {
  return (list || []).slice().sort((a, b) => {
    const d = msgTime(a) - msgTime(b);
    if (d !== 0) return d;
    const ia = String(a.id || a.key || '');
    const ib = String(b.id || b.key || '');
    if (ia.charAt(0) === '-' && ib.charAt(0) === '-' && ia !== ib) {
      return ia < ib ? -1 : 1;
    }
    return ia.localeCompare(ib);
  });
}
</file>

