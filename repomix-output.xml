}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-clear {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 16px;
  cursor: pointer;
  padding: 4px 8px;
}
.search-clear:hover {
  color: var(--text-primary);
}

.search-skeleton-wrapper {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.premium-status-pill,
.premium-end-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 10px 20px;
  margin: 18px auto 8px;
  width: fit-content;
  max-width: 90%;
