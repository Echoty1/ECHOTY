import React, { useState, useEffect, useRef } from 'react';
import ReactDOM from 'react-dom';

const EditMessageModal = ({ isOpen, onClose, messageText, onSave }) => {
  const [text, setText] = useState('');
  const textareaRef = useRef(null);

  useEffect(() => {
    if (isOpen) {
      setText(messageText || '');
      setTimeout(() => {
        if (textareaRef.current) {
          textareaRef.current.focus();
          textareaRef.current.select();
        }
      }, 100);
    }
  }, [isOpen, messageText]);

  const handleSave = () => {
    const trimmed = text.trim();
    if (trimmed && trimmed !== messageText) {
      onSave(trimmed);
    }
    onClose();
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSave();
    }
    if (e.key === 'Escape') {
      onClose();
    }
  };

  if (!isOpen) return null;

  return ReactDOM.createPortal(
    <div className="edit-modal-overlay" onClick={onClose}>
      <div className="edit-modal-content" onClick={(e) => e.stopPropagation()}>
        <div className="edit-modal-header">
          <h3>Edit Message</h3>
          <button className="edit-modal-close" onClick={onClose}>✕</button>
        </div>
        <textarea
          ref={textareaRef}
          className="edit-modal-textarea"
          value={text}
          onChange={(e) => setText(e.target.value)}
          onKeyDown={handleKeyDown}
          rows={3}
          placeholder="Edit your message..."
        />
        <div className="edit-modal-actions">
          <button className="edit-modal-btn cancel" onClick={onClose}>Cancel</button>
          <button
            className="edit-modal-btn save"
            onClick={handleSave}
            disabled={!text.trim() || text.trim() === messageText}
          >
            Save
          </button>
        </div>
      </div>
    </div>,
    document.body
  );
};

export default EditMessageModal;
</file>

<file path="src/components/pages/CommunityChat/CommunityWall.css">
/* src/components/pages/CommunityChat/CommunityWall.css */

.community-wall-container {
  padding: 16px 16px 132px; /* clear bottom nav */
  display: flex;
  flex-direction: column;
  gap: 16px;
  height: 100%;
  overflow-y: auto;
  scroll-behavior: smooth;
}

/* ─── Feed ────────────────────────────────────────────────────── */
.wall-feed {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
}

.wall-feed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.wall-feed-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.wall-feed-title {
  font-weight: 700;
  font-size: 18px;
  color: var(--text-primary);
}

.wall-filter-clear {
  background: rgba(108, 60, 225, 0.1);
  border: none;
  color: #8B5CF6;
  font-size: 13px;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  transition: background 0.2s;
}

.wall-filter-clear:hover {
  background: rgba(108, 60, 225, 0.2);
}

.wall-filter-badge {
  background: rgba(108, 60, 225, 0.06);
  border: 1px solid rgba(108, 60, 225, 0.15);
  border-radius: 12px;
  padding: 8px 14px;
  font-size: 14px;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 8px;
}

.wall-filter-badge strong {
  color: var(--text-primary);
}

.wall-add-post-btn {
  border: none;
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  color: #fff;
  font-weight: 600;
  font-size: 13px;
  padding: 8px 16px;
  border-radius: 20px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: transform 0.15s, box-shadow 0.15s;
}

.wall-add-post-btn:hover {
  transform: scale(1.02);
  box-shadow: 0 4px 16px rgba(108, 60, 225, 0.3);
}

.wall-feed-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  color: var(--text-muted);
  gap: 12px;
  background: var(--bg-input);
  border-radius: 16px;
  border: 1px solid var(--border-color);
}

.wall-feed-empty i {
  font-size: 48px;
  opacity: 0.3;
}

.wall-feed-empty p {
  margin: 0;
  font-size: 15px;
}

/* ─── Individual Post ──────────────────────────────────────────── */
.wall-post {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 14px;
  transition: border-color 0.2s;
}

.wall-post:hover {
  border-color: rgba(108, 60, 225, 0.15);
}

.wall-post-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.wall-post-author {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.wall-post-name {
  font-weight: 600;
  font-size: 14px;
  color: var(--text-primary);
}

.wall-post-time {
  font-size: 11px;
  color: var(--text-muted);
}

.wall-post-delete {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 50%;
  transition: background 0.15s, color 0.15s;
}

.wall-post-delete:hover {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

.wall-post-text {
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 10px;
  white-space: pre-wrap;
  color: var(--text-primary);
}

/* ─── Media ────────────────────────────────────────────────────── */
.wall-post-media {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60px;
}

.wall-post-image {
  display: block;
  width: 100%;
  height: auto;
  max-height: 500px;
  object-fit: contain;
  background: transparent;
  transition: opacity 0.3s ease;
}

.wall-post-video {
  display: block;
  width: 100%;
  height: auto;
  max-height: 500px;
  object-fit: contain;
  background: transparent;
}

.wall-post-media-overlay {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  opacity: 0.7;
  transition: opacity 0.2s;
  pointer-events: none;
}

.wall-post-media:hover .wall-post-media-overlay {
  opacity: 1;
}

/* ─── Media Loader ─────────────────────────────────────────────── */
.wall-post-media-loader {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
}

.loader-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid rgba(255, 255, 255, 0.1);
  border-top-color: #6C3CE1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ─── Add Post Modal ──────────────────────────────────────────── */
.wall-add-post-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99999;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.2s ease;
}

.wall-add-post-modal {
  background: var(--bg-secondary);
  border-radius: 20px;
  padding: 24px;
  max-width: 480px;
  width: 100%;
  border: 1px solid var(--border-color);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  animation: scaleIn 0.25s ease;
}

.wall-add-post-modal h3 {
  margin: 0 0 16px;
  font-size: 18px;
  color: var(--text-primary);
}

.wall-add-post-preview {
  border-radius: 12px;
  overflow: hidden;
  background: var(--bg-input);
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  cursor: pointer;
  border: 2px dashed var(--border-color);
  transition: border-color 0.2s;
}

.wall-add-post-preview:hover {
  border-color: rgba(108, 60, 225, 0.3);
}

.wall-add-post-dropzone {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 20px;
  color: var(--text-muted);
  width: 100%;
}

.wall-add-post-dropzone i {
  font-size: 36px;
  opacity: 0.5;
}

.wall-add-post-dropzone span {
  font-size: 14px;
}

.wall-preview-image,
.wall-preview-video {
  width: 100%;
  max-height: 240px;
  object-fit: contain;
}

.wall-upload-error {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 10px;
  padding: 10px 14px;
  margin-bottom: 12px;
  color: #ef4444;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.wall-add-post-modal textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 12px;
  border: 1px solid var(--border-color);
  background: var(--bg-input);
  color: var(--text-primary);
  padding: 10px 12px;
  font-family: inherit;
  font-size: 14px;
  resize: vertical;
  min-height: 60px;
  margin-bottom: 16px;
  outline: none;
  transition: border-color 0.2s;
}

.wall-add-post-modal textarea:focus {
  border-color: #6C3CE1;
}

.wall-add-post-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.wall-add-post-actions button {
  padding: 10px 20px;
  border-radius: 30px;
  border: none;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}

.wall-add-post-actions button:first-child {
  background: var(--bg-input);
  color: var(--text-secondary);
}

.wall-add-post-actions button:first-child:hover:not(:disabled) {
  background: var(--border-color);
}

.wall-add-post-actions button:last-child {
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  color: #fff;
}

.wall-add-post-actions button:last-child:hover:not(:disabled) {
  transform: scale(1.02);
  box-shadow: 0 4px 16px rgba(108, 60, 225, 0.3);
}

.wall-add-post-actions button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none !important;
}

/* ─── Loading ───────────────────────────────────────────────────── */
.wall-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  color: var(--text-muted);
}

/* ─── Animations ───────────────────────────────────────────────── */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* ─── Responsive ────────────────────────────────────────────────── */
@media (max-width: 480px) {
