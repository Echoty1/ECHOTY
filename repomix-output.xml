  .live-viewer-chat-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .live-viewer-stage:has(.live-viewer-chat-pane.is-closed) .live-viewer-video-pane {
    flex: 1;
    height: auto;
  }
}

@media (max-width: 480px) {
  .live-viewer-video-pane {
    flex-basis: 40vh;
    height: 40vh;
  }
  .live-viewer-chip {
    top: 10px;
    left: 10px;
    padding: 5px 10px;
    font-size: 12px;
  }
}

.live-viewer-count,
.broadcast-viewer-count {
  margin-left: 8px;
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,0.92);
  background: rgba(0,0,0,0.45);
  border: 1px solid rgba(255,255,255,0.12);
  padding: 4px 10px;
  border-radius: 999px;
}

.live-dialog-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(8, 8, 14, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  backdrop-filter: blur(10px);
}

.live-dialog {
  width: min(420px, 100%);
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 18px;
  padding: 28px 24px 22px;
  box-shadow: 0 24px 80px rgba(0,0,0,0.45);
  color: var(--text-primary);
  text-align: left;
}

.live-dialog-kicker {
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.live-dialog-title {
  margin: 0 0 8px;
  font-size: 20px;
  font-weight: 650;
  line-height: 1.3;
}

.live-dialog-copy {
  margin: 0 0 22px;
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.5;
}

.live-dialog-actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

.live-dialog-primary,
.live-dialog-danger,
.live-dialog-ghost {
  border: none;
  border-radius: 12px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.live-dialog-primary { background: #6C3CE1; color: #fff; width: 100%; }
.live-dialog-danger { background: #e11d48; color: #fff; }
.live-dialog-ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--border-color); }
</file>

<file path="src/components/VideoChat/VideoCallModal.css">
/* src/components/VideoChat/VideoCallModal.css */
/* ECHO-branded video call UI – not WhatsApp-style */

.echo-call {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  background: #0A0A0F;
  color: #fff;
  overflow: hidden;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

/* Soft ambient gradient wash */
.echo-call::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 50% 20%, rgba(108, 60, 225, 0.18), transparent 60%),
    radial-gradient(ellipse 60% 40% at 80% 80%, rgba(236, 72, 153, 0.1), transparent 50%),
    radial-gradient(ellipse 50% 30% at 10% 70%, rgba(108, 60, 225, 0.08), transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* ─── Stage (remote video / placeholder) ─────────────────────── */
.echo-call-stage {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  min-height: 0;
}

.echo-call-remote-video {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #000;
}

/* ─── Ringing / connecting placeholder ───────────────────────── */
.echo-call-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
  position: absolute;
  inset: 0;
  z-index: 2;
  text-align: center;
}

/* Rings sit behind the avatar, centered on the avatar stack */
.echo-call-rings {
  position: absolute;
  width: 220px;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  /* Centered via flex parent; offset so rings sit on avatar */
  top: 50%;
  left: 50%;
  transform: translate(-50%, calc(-50% - 36px));
}

.echo-call-ring {
  position: absolute;
  border-radius: 50%;
  border: 2px solid rgba(108, 60, 225, 0.35);
  animation: echoPulse 2.8s ease-out infinite;
}

.echo-call-ring:nth-child(1) {
  width: 140px;
  height: 140px;
  animation-delay: 0s;
}

.echo-call-ring:nth-child(2) {
  width: 180px;
  height: 180px;
  border-color: rgba(236, 72, 153, 0.25);
  animation-delay: 0.7s;
}

.echo-call-ring:nth-child(3) {
  width: 220px;
  height: 220px;
  border-color: rgba(108, 60, 225, 0.15);
  animation-delay: 1.4s;
}

@keyframes echoPulse {
  0% {
    transform: scale(0.85);
    opacity: 0.9;
  }
  100% {
    transform: scale(1.35);
    opacity: 0;
  }
}

.echo-call-avatar-wrap {
  position: relative;
  z-index: 2;
  border-radius: 50%;
  padding: 4px;
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  box-shadow:
    0 0 40px rgba(108, 60, 225, 0.45),
    0 0 80px rgba(236, 72, 153, 0.2);
  line-height: 0;
  flex-shrink: 0;
}

.echo-call-avatar-wrap img,
.echo-call-avatar-wrap .initials-avatar {
  display: block;
  border-radius: 50%;
  border: 3px solid #0A0A0F;
  margin: 0 auto;
}

.echo-call-name {
  margin-top: 28px;
  font-size: clamp(22px, 5vw, 28px);
  font-weight: 800;
  letter-spacing: 0.5px;
  background: linear-gradient(135deg, #fff 30%, #c4b5fd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-align: center;
}

.echo-call-status {
  margin-top: 10px;
  font-size: 14px;
  font-weight: 500;
  color: rgba(167, 139, 250, 0.9);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}

.echo-call-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #a78bfa;
  animation: statusBlink 1.2s ease-in-out infinite;
}

.echo-call-status-dot.live {
  background: #4ade80;
  box-shadow: 0 0 10px #4ade80;
  animation: none;
}

@keyframes statusBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.echo-call-sub {
  margin-top: 6px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.35);
}

/* Brand mark while ringing */
.echo-call-brand {
  position: absolute;
  top: 28px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 4px;
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  z-index: 5;
  opacity: 0.9;
}

/* ─── Connected: name + duration chip on video ───────────────── */
.echo-call-live-chip {
  position: absolute;
  bottom: 24px;
  left: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  background: rgba(10, 10, 15, 0.7);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(108, 60, 225, 0.3);
  border-radius: 24px;
  font-size: 13px;
  font-weight: 600;
  z-index: 5;
}

.echo-call-live-chip .duration {
  color: #4ade80;
  font-variant-numeric: tabular-nums;
  margin-left: 4px;
  font-weight: 700;
}

/* ─── Local PiP ──────────────────────────────────────────────── */
.echo-call-pip {
  position: absolute;
  bottom: 120px;
  right: 16px;
  width: 110px;
  height: 150px;
  border-radius: 16px;
  overflow: hidden;
  border: 2px solid rgba(108, 60, 225, 0.5);
  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.5),
    0 0 20px rgba(108, 60, 225, 0.25);
  z-index: 10;
  background: #000;
}

.echo-call-pip video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scaleX(-1);
}

.echo-call-pip-label {
  position: absolute;
  bottom: 6px;
  left: 8px;
  font-size: 10px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(0, 0, 0, 0.5);
  padding: 2px 8px;
  border-radius: 8px;
  letter-spacing: 0.5px;
}

.echo-call-pip-off {
  position: absolute;
  inset: 0;
  background: rgba(10, 10, 15, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(167, 139, 250, 0.8);
  font-size: 22px;
}

@media (min-width: 768px) {
  .echo-call-pip {
    width: 160px;
    height: 120px;
    bottom: 130px;
    right: 24px;
  }
}

/* ─── Controls bar ───────────────────────────────────────────── */
.echo-call-controls {
  position: relative;
  z-index: 20;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  padding: 20px 16px 36px;
  background: linear-gradient(to top, rgba(10, 10, 15, 0.95) 40%, transparent);
}

.echo-call-btn {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #fff;
  transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
}

.echo-call-btn:hover {
  transform: scale(1.08);
  background: rgba(255, 255, 255, 0.14);
}

.echo-call-btn:active {
  transform: scale(0.95);
}

.echo-call-btn.accept {
  width: 68px;
  height: 68px;
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  border: none;
  box-shadow: 0 6px 28px rgba(108, 60, 225, 0.5);
  font-size: 24px;
}

.echo-call-btn.accept:hover {
  box-shadow: 0 8px 36px rgba(108, 60, 225, 0.65);
}

.echo-call-btn.decline {
  width: 68px;
  height: 68px;
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #f87171;
  font-size: 22px;
}

.echo-call-btn.decline:hover {
  background: rgba(239, 68, 68, 0.35);
}

.echo-call-btn.end {
  background: rgba(239, 68, 68, 0.25);
  border: 1px solid rgba(239, 68, 68, 0.45);
  color: #f87171;
}

.echo-call-btn.end:hover {
  background: rgba(239, 68, 68, 0.4);
}

.echo-call-btn.muted,
.echo-call-btn.video-off {
  background: rgba(108, 60, 225, 0.25);
  border-color: rgba(108, 60, 225, 0.4);
  color: #c4b5fd;
}

/* Remote mute badge in live chip */
.echo-call-mute-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.25);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #f87171;
  font-size: 11px;
  margin-left: 4px;
}

.echo-call-remote-mute-float {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: rgba(10, 10, 15, 0.75);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(239, 68, 68, 0.35);
  border-radius: 20px;
  color: #f87171;
  font-size: 13px;
  font-weight: 600;
  z-index: 6;
}

/* Local PiP when camera off – show own avatar */
.echo-call-pip-avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #1a1230, #0A0A0F);
}

.echo-call-pip-mute {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.85);
  color: #fff;
  font-size: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ─── End / declined screens ─────────────────────────────────── */
.echo-call-result {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
  padding: 32px;
  text-align: center;
}

.echo-call-result-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  margin-bottom: 20px;
}

.echo-call-result-icon.declined {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.echo-call-result-icon.ended {
  background: rgba(108, 60, 225, 0.15);
  border: 1px solid rgba(108, 60, 225, 0.3);
}

.echo-call-result h2 {
  margin: 0;
  font-size: 24px;
  font-weight: 800;
}

.echo-call-result p {
  margin: 12px 0 28px;
  color: rgba(255, 255, 255, 0.5);
  font-size: 15px;
}

.echo-call-result-btn {
  padding: 12px 36px;
  border: none;
  border-radius: 30px;
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 24px rgba(108, 60, 225, 0.35);
  transition: transform 0.15s, box-shadow 0.2s;
}

.echo-call-result-btn:hover {
  transform: scale(1.04);
  box-shadow: 0 6px 32px rgba(108, 60, 225, 0.5);
}

/* ─── Mobile tweaks ──────────────────────────────────────────── */
@media (max-width: 480px) {
  .echo-call-rings {
    width: 170px;
    height: 170px;
  }
  .echo-call-ring:nth-child(1) { width: 120px; height: 120px; }
  .echo-call-ring:nth-child(2) { width: 150px; height: 150px; }
  .echo-call-ring:nth-child(3) { width: 180px; height: 180px; }
  .echo-call-controls {
    gap: 16px;
    padding: 16px 12px 28px;
  }
  .echo-call-btn {
    width: 50px;
    height: 50px;
    font-size: 18px;
  }
  .echo-call-btn.accept,
  .echo-call-btn.decline {
    width: 60px;
    height: 60px;
  }
}


/* ─── Call stage progress: Ringing → Connecting → Connected ─── */
.echo-stage-line {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 0;
  margin-top: 22px;
  width: min(92vw, 340px);
  padding: 0 4px;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.echo-stage-step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  background: none;
  border: none;
  padding: 8px 4px 4px;
  cursor: pointer;
  color: rgba(255, 255, 255, 0.35);
  transition: color 0.25s ease, transform 0.2s ease;
}

.echo-stage-step.done {
  color: #a78bfa;
}
.echo-stage-step.current {
  color: #e9d5ff;
}
.echo-stage-step.tapped {
  transform: scale(1.08);
}

.echo-stage-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
  border: 2px solid rgba(255, 255, 255, 0.2);
  background: rgba(10, 10, 15, 0.6);
  transition: all 0.3s ease;
  z-index: 2;
}

.echo-stage-step.done .echo-stage-dot {
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 0 16px rgba(108, 60, 225, 0.45);
}

.echo-stage-step.current .echo-stage-dot {
  border-color: #c4b5fd;
  color: #c4b5fd;
  box-shadow: 0 0 0 4px rgba(108, 60, 225, 0.2);
  animation: stagePulse 1.6s ease-in-out infinite;
}

.echo-stage-step.tapped .echo-stage-dot {
  transform: scale(1.15);
  box-shadow: 0 0 20px rgba(236, 72, 153, 0.5);
}

.echo-stage-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  white-space: nowrap;
}

.echo-stage-bar {
  position: absolute;
  top: 20px; /* center of dot */
  left: calc(50% + 16px);
  right: calc(-50% + 16px);
  height: 3px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.12);
  z-index: 1;
  overflow: hidden;
}

.echo-stage-bar.filled {
  background: linear-gradient(90deg, #6C3CE1, #EC4899);
}

.echo-stage-bar.active::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, #c4b5fd, transparent);
  animation: stageShimmer 1.4s ease-in-out infinite;
}

@keyframes stagePulse {
  0%, 100% { box-shadow: 0 0 0 4px rgba(108, 60, 225, 0.15); }
  50% { box-shadow: 0 0 0 8px rgba(108, 60, 225, 0.28); }
}

@keyframes stageShimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

@media (max-width: 380px) {
  .echo-stage-label {
    font-size: 9px;
  }
  .echo-stage-dot {
    width: 24px;
    height: 24px;
    font-size: 10px;
  }
  .echo-stage-bar {
    top: 18px;
  }
}


.echo-call-timer-large {
  margin-top: 16px;
  font-size: 28px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: 2px;
  color: #4ade80;
  text-shadow: 0 0 20px rgba(74, 222, 128, 0.35);
}

.echo-stage-line.stage-2 .echo-stage-step.done .echo-stage-dot {
  box-shadow: 0 0 18px rgba(74, 222, 128, 0.35);
}

.echo-stage-step.current .echo-stage-dot .fa-circle {
  font-size: 8px;
  animation: stageDotBlink 1s ease-in-out infinite;
}

@keyframes stageDotBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.echo-stage-step:active {
  transform: scale(0.94);
}

.echo-stage-line:active {
  filter: brightness(1.15);
}
</file>

