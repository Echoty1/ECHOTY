}

.home-section:hover {
  border-color: rgba(108, 60, 225, 0.2);
  box-shadow: 0 24px 72px rgba(108, 60, 225, 0.08);
}

/* ─── Header ────────────────────────────────────────────────────── */
.live-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  flex-wrap: wrap;
  gap: 8px;
}

.live-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.live-header-left h2 {
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0;
  letter-spacing: -0.3px;
}

.live-indicator-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 20px rgba(74, 222, 128, 0.6);
  animation: pulse-dot 1.5s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

.live-header-right {
  display: flex;
  align-items: center;
}

.live-count-badge {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--bg-input);
  padding: 6px 14px;
  border-radius: 20px;
  border: 1px solid var(--border-color);
  white-space: nowrap;
}

/* ─── Subtitle ──────────────────────────────────────────────────── */
.live-subtitle {
  font-size: 14px;
  color: var(--text-muted);
  margin: 4px 0 20px 0;
  letter-spacing: 0.2px;
}

/* ─── Horizontal Scroll Container ────────────────────────────── */
.live-users-scroll {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  padding: 8px 4px 16px;
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb, #6C3CE1) transparent;
}

.live-users-scroll::-webkit-scrollbar {
  height: 4px;
}

.live-users-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.live-users-scroll::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb, #6C3CE1);
  border-radius: 4px;
}

.live-users-scroll::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover, #8B5CF6);
}

/* ─── User Card ────────────────────────────────────────────────── */
.live-user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-width: 85px;
  flex-shrink: 0;
  cursor: pointer;
  transition: transform 0.2s ease, opacity 0.2s ease;
  padding: 8px 4px;
  border-radius: 16px;
  background: transparent;
  border: 1px solid transparent;
}

.live-user-card:hover {
  transform: translateY(-4px) scale(1.02);
  background: var(--bg-input);
  border-color: var(--border-color);
}

.live-user-card:active {
  transform: scale(0.98);
}

.live-user-card.is-live .live-avatar-ring {
  background: linear-gradient(135deg, #6C3CE1, #a78bfa);
  padding: 3px;
  border-radius: 50%;
  box-shadow: 0 0 24px rgba(108, 60, 225, 0.6), 0 0 48px rgba(108, 60, 225, 0.2);
  animation: live-ring-pulse 1.6s ease-in-out infinite;
}

@keyframes live-ring-pulse {
  0%, 100% { box-shadow: 0 0 24px rgba(108, 60, 225, 0.6), 0 0 48px rgba(108, 60, 225, 0.2); }
  50% { box-shadow: 0 0 32px rgba(108, 60, 225, 0.9), 0 0 64px rgba(108, 60, 225, 0.35); }
}

.live-avatar-wrapper {
  position: relative;
  display: inline-block;
  line-height: 0;
}

.live-avatar-ring {
  border-radius: 50%;
  display: inline-block;
  line-height: 0;
}

.live-avatar-ring > * {
  border-radius: 50%;
  border: 2px solid var(--bg-primary);
}

.live-badge {
  position: absolute;
  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);
  background: #ef4444;
  color: #fff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.5px;
  padding: 2px 10px;
  border-radius: 12px;
  white-space: nowrap;
  box-shadow: 0 0 16px rgba(239, 68, 68, 0.5);
