/* src/components/pages/Chat/ChatView.css */
:root {
  --header-height: 60px;
  --nav-bottom-offset: 88px;
}

.chat-view {
  position: fixed;
  top: var(--header-height);
  bottom: var(--nav-bottom-offset);
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
  overflow: hidden;
  /* rings are absolute inside this fixed shell */
  margin: 0 !important;
  padding: 0 !important;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  z-index: 10;
  transition: bottom 0.25s ease;
}

.messages-container {
  flex: 1;
  overflow-y: auto;
  scroll-behavior: smooth;
  padding: 72px 16px 12px !important;
  display: flex;
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 8px;
  margin: 0 !important;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  transition: padding-bottom 0.25s ease;
  position: relative;
  z-index: 2; /* above rings – no blur on messages */
  background: transparent;
}

/* Full-width row keeps TIME order (not grouped by sender) */
.message-row {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
  flex: 0 0 auto;
  box-sizing: border-box;
}
.message-row.own {
