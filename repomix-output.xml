/* src/components/pages/Admin/AdminPanel.css */
.admin-panel {
  max-width: 1400px;
  margin: 0 auto;
  padding: 20px 16px 80px;
  color: var(--text-primary);
  box-sizing: border-box;
  overflow-x: hidden;
}

.admin-stats-row {
  display: flex;
  gap: 24px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}
.admin-stats-left {
  flex: 1;
  min-width: 200px;
}
.admin-stats-right {
  flex: 1;
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}
.stat-card {
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 16px 20px;
  flex: 1;
  min-width: 120px;
  transition: border-color 0.2s;
}
.stat-card .stat-label {
  font-size: 13px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 600;
}
.stat-card .stat-value {
  font-size: 32px;
  font-weight: 700;
  margin-top: 4px;
  color: var(--text-primary);
}
.stat-card.daily-active .stat-value {
  color: #10B981;
}
.stat-card.online-now .stat-value {
  color: #8B5CF6;
}

.admin-chart-container {
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 20px 24px;
  margin-bottom: 24px;
}
.admin-chart-container h3 {
  font-size: 16px;
  font-weight: 600;
  margin: 0 0 16px 0;
  color: var(--text-primary);
}
.admin-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 160px;
  gap: 8px;
  padding: 8px 0;
}
.chart-bar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}
.chart-bar-label {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 6px;
  text-transform: uppercase;
}
.chart-bar-track {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: var(--bg-input);
  border-radius: 4px;
  position: relative;
  min-height: 100px;
}
.chart-bar {
  width: 60%;
  min-height: 4px;
  border-radius: 4px 4px 0 0;
  transition: height 0.3s ease;
}
.chart-bar-value {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 4px;
}
.chart-loading,
.chart-empty {
  color: var(--text-muted);
  text-align: center;
  padding: 30px 0;
  width: 100%;
}

.admin-two-col {
  display: flex;
  gap: 32px;
  align-items: flex-start;
}
.admin-col-left {
  flex: 1.2;
  min-width: 0;
}
.admin-col-right {
  flex: 1.5;
  min-width: 320px;
  max-width: 480px;
}
@media (max-width: 1024px) {
  .admin-two-col {
    flex-direction: column;
  }
  .admin-col-left,
  .admin-col-right {
    flex: 1;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }
  .admin-stats-left,
  .admin-stats-right {
    flex: 1 1 100%;
  }
  .admin-stats-right {
    flex-direction: row;
  }
  .admin-chart {
    height: 120px;
  }
  .chart-bar-track {
    min-height: 70px;
  }
}

.admin-header {
  margin-bottom: 24px;
}
.admin-panel h1 {
  font-size: 28px;
  margin-bottom: 4px;
  background: linear-gradient(135deg, #6C3CE1, #EC4899);
