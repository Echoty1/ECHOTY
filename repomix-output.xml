          >
            {[...DEFAULT_INTEREST_TEMPLATES, ...DEFAULT_INTEREST_TEMPLATES].map((item, idx) => (
              <span
                key={idx}
                style={{
                  background: 'rgba(255, 255, 255, 0.08)',
                  color: '#AAA',
                  border: '1px solid rgba(255, 255, 255, 0.12)',
