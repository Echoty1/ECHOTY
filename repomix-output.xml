.chat-search-wrapper .search-clear:hover {
  color: var(--text-primary);
}
/* ─── Responsive tweaks ────────────────────────────────────── */
@media (max-width: 600px) {
  .chat-list-header {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  .chat-actions {
    justify-content: stretch;
  }
  .chat-actions button {
